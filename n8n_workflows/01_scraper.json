      "id": "e6d9d319-9791-4466-8f57-3cb4e0b04c07",
      "name": "Fetch_NewsAPI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        250,
        640
      ],
      "credentials": {
        "httpBasicAuth": {
          "id": "REPLACE_IN_N8N",
          "name": "REPLACE_IN_N8N"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse NewsAPI response and normalize articles\nconst articles = $input.first().json.articles || [];\nconst category = $input.first().json.categories.split(',')[0];\nconst timestamp = new Date().toISOString();\n\nconst normalized = articles.map((article) => ({\n  id: `${Date.now()}-${Math.random().toString(36).substr(2, 9)}`,\n  original_title: article.title || '',\n  normalized_title: (article.title || '').toLowerCase().trim(),\n  category: category,\n  source_key: article.source?.id || 'unknown',\n  source_name: article.source?.name || 'Unknown',\n  url: article.url || '',\n  image_url: article.urlToImage || null,\n  published_at: article.publishedAt,\n  scraped_at: timestamp,\n  description: article.description || '',\n  content: article.content || '',\n  embedding: null,\n  status: 'pending_research',\n  created_at: timestamp,\n  expires_at: new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString()\n})).filter(a => a.original_title && a.original_title.length > 5);\n\nreturn {\n  json: {\n    articles: normalized,\n    count: normalized.length,\n    category: category,\n    timestamp: timestamp\n  }\n};"
      },
      "id": "26b082a6-225a-4055-a1b2-0d5e95987e13",
      "name": "Parse_Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        250,
        820
      ]
    },
    {
      "parameters": {},
      "id": "2a8565be-3484-40c7-8d96-9e0a9e7b8ae2",
      "name": "Accumulate_Articles",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        250,
        1000
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, embedding FROM headlines WHERE created_at > NOW() - INTERVAL '1 day' AND embedding IS NOT NULL LIMIT 1000;",
        "options": {}
      },
      "id": "3f61e817-256c-487d-a80c-f88a3495613c",
      "name": "Get_Existing_Embeddings",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        250,
        1180
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_IN_N8N",
          "name": "REPLACE_IN_N8N"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EMBEDDING_SERVICE_URL || 'http://localhost:8000/embed-batch' }}",
        "sendBody": true,
        "contentType": "json",
        "body": {
          "texts": "={{ $json.articles.map(a => a.normalized_title) }}"
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "fb9b64dd-a65e-4072-aa05-d4fbb0298503",
      "name": "Generate_Embeddings",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        250,
        1360
      ]
    },
    {
      "parameters": {
        "jsCode": "// Semantic deduplication using cosine similarity\nconst newArticles = $input.first().json.articles || [];\nconst embeddings = $input.first().json.embeddings || [];\nconst existingRows = $input.all()[1]?.json || [];\n\n// Attach embeddings to articles\nconst articlesWithEmb = newArticles.map((article, i) => ({\n  ...article,\n  embedding: embeddings[i] || null\n}));\n\nfunction cosineSimilarity(vecA, vecB) {\n  if (!vecA || !vecB || vecA.length !== vecB.length) return 0;\n  const dot = vecA.reduce((sum, val, i) => sum + val * vecB[i], 0);\n  const normA = Math.sqrt(vecA.reduce((sum, val) => sum + val * val, 0));\n  const normB = Math.sqrt(vecB.reduce((sum, val) => sum + val * val, 0));\n  return normA && normB ? dot / (normA * normB) : 0;\n}\n\nconst threshold = parseFloat($input.first().json.similarity_threshold || 0.85);\nconst deduplicated = [];\nlet duplicatesRemoved = 0;\n\nfor (const article of articlesWithEmb) {\n  if (!article.embedding) { deduplicated.push(article); continue; }\n  let isDup = false;\n  for (const existing of existingRows) {\n    const existingEmb = existing.embedding;\n    if (!existingEmb) continue;\n    if (cosineSimilarity(article.embedding, existingEmb) > threshold) {\n      isDup = true; duplicatesRemoved++; break;\n    }\n  }\n  if (!isDup) deduplicated.push(article);\n}\n\nreturn {\n  json: {\n    deduplicated_articles: deduplicated,\n    unique_count: deduplicated.length,\n    duplicates_removed: duplicatesRemoved,\n    total_fetched: articlesWithEmb.length\n  }\n};"
      },
