# NewsIQ public configuration template
# Copy to .env and replace every placeholder locally. Never commit .env.

NEWSAPI_KEY=YOUR_NEWSAPI_KEY
SERPAPI_KEY=YOUR_SERPAPI_KEY
CLAUDE_API_KEY=YOUR_CLAUDE_API_KEY

GOOGLE_TTS_KEY=YOUR_GOOGLE_TTS_KEY
GOOGLE_DRIVE_CREDENTIALS_PATH=/path/to/google-service-account.json
GOOGLE_FOLDER_ID=YOUR_GOOGLE_DRIVE_FOLDER_ID

YOUTUBE_CLIENT_ID=YOUR_YOUTUBE_CLIENT_ID
YOUTUBE_CLIENT_SECRET=YOUR_YOUTUBE_CLIENT_SECRET
YOUTUBE_REFRESH_TOKEN=YOUR_YOUTUBE_REFRESH_TOKEN
TIKTOK_API_KEY=YOUR_TIKTOK_API_KEY
TIKTOK_ACCESS_TOKEN=YOUR_TIKTOK_ACCESS_TOKEN
INSTAGRAM_ACCESS_TOKEN=YOUR_INSTAGRAM_ACCESS_TOKEN
INSTAGRAM_ACCOUNT_ID=YOUR_INSTAGRAM_ACCOUNT_ID

TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_WHATSAPP_FROM=whatsapp:+10000000000

DATABASE_URL=postgresql://user:password@localhost:5432/news_iq
USER_EMAIL=user@example.com
USER_PHONE=+10000000000

VIDEO_SERVICE_URL=http://localhost:8001
EMBEDDING_SERVICE_URL=http://localhost:8001
N8N_WEBHOOK_URL=https://your-n8n-instance.example/webhook
N8N_API_KEY=YOUR_N8N_API_KEY

SLACK_WEBHOOK_URL=YOUR_SLACK_WEBHOOK_URL
SENTRY_DSN=YOUR_SENTRY_DSN

# Video worker storage
BUCKET_NAME=YOUR_BUCKET_NAME
BUCKET_REGION=YOUR_BUCKET_REGION
BUCKET_ENDPOINT=YOUR_BUCKET_ENDPOINT
BUCKET_ACCESS_KEY=YOUR_BUCKET_ACCESS_KEY
BUCKET_SECRET_KEY=YOUR_BUCKET_SECRET_KEY

